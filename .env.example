# Resilience Scout — environment template (Phase 1)
# Copy to .env for local overrides. Do not commit secrets.

# Application
APP_NAME=Resilience Scout
APP_ENV=development
DEBUG=true

# Paths (relative to repo root unless absolute)
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_PROVENANCE_DIR=data/provenance
INDICATOR_REGISTRY_PATH=data/indicator_registry.yaml

